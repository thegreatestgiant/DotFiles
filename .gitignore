ssh/.ssh/environment-*
ssh/.ssh/known_hosts
ssh/.ssh/known_hosts.old

# Ignore Tmux plugins in standard location
tmux/.tmux/plugins/*
# !tmux/.tmux/plugins/tpm

# Ignore Tmux plugins in XDG config location
tmux/.config/tmux/plugins/*
# !tmux/.config/tmux/plugins/tpm

# Ignore Wallust generated output files (but keep directories via .gitkeep)
**/rofi/wallust/*
**/waybar/wallust/*
!**/.gitkeep
**/01-Wallust.conf
**/cava

# Ignore wallpaper state files
.current_wallpaper
.wallpaper_current

# Wallust-generated theme files (regenerated per-wallpaper, not source config)
hypr/.config/hypr/wallust/wallust-hyprland.conf
hypr/.config/hypr/rofi/wallust/*
!hypr/.config/hypr/rofi/wallust/.gitkeep
hypr/.config/hypr/waybar/wallust/*
!hypr/.config/hypr/waybar/wallust/.gitkeep
hypr/.config/hypr/cava/config
