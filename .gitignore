ssh/.ssh/environment-*

# Ignore Tmux plugins in standard location
tmux/.tmux/plugins/*
# !tmux/.tmux/plugins/tpm

# Ignore Tmux plugins in XDG config location
tmux/.config/tmux/plugins/*
# !tmux/.config/tmux/plugins/tpm

# Ignore Wallust generated output files (but keep directories via .gitkeep)
**/rofi/wallust/*
**/waybar/wallust/*
!**/.gitkeep
**/01-Wallust.conf
**/cava

# Ignore wallpaper state files
.current_wallpaper
.wallpaper_current
